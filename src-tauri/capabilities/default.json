{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Kiln's editor and its output window",
  "windows": ["main", "output"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-destroy",
    "core:window:allow-set-theme",
    "core:window:allow-hide",
    "dialog:default",
    "log:default",
    "opener:default"
  ]
}
